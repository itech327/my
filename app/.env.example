# Local Moroccan Darija voice service (.claude/skills/darija-voice/scripts/server.py).
# Leave empty to use the placeholder engine for every dialect.
TTS_DARIJA_URL=http://127.0.0.1:5005

# DODa speaker voices via F5-TTS (.claude/skills/darija-voice/scripts/f5_server.py).
# Enables the female Moroccan voice. Slow on a CPU: several seconds per sentence.
TTS_SPEAKERS_URL=http://127.0.0.1:5007

# Google Gemini TTS through the official API. The key is a network secret for
# generativelanguage.googleapis.com (never in this file). 1 = show the Gemini voices.
TTS_GEMINI=0

# In a cloud session behind the agent proxy, start Node with NODE_USE_ENV_PROXY=1
# (Node >= 22.21), or server-side fetch to Gemini bypasses the proxy and fails.
