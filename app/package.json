{
  "name": "tts-clone",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3000",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "tokens": "python3 ../replica/design/build_tokens.py && cp ../replica/design/tokens.css src/styles/tokens.css && cp ../replica/design/tailwind.tokens.js tailwind.tokens.js",
    "test:d1": "WRANGLER_SEND_METRICS=false tsx scripts/test-d1.mts",
    "test:normalize": "tsx scripts/test-normalize.mts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "lucide-react": "1.77.0",
    "next": "15.5.29",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.7.0",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "^4.167.0"
  }
}